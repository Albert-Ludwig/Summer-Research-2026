Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: SLAM Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cpr_j100_0001/map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cpr_j100_0001/map_updates
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cpr_j100_0001/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
      Name: Jackal Robot
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Active Goal Marker
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /social_nav_diffusion/active_goal_marker
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 0; 255; 80
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.08
      Line Style: Lines
      Line Width: 0.05
      Name: Projected Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Style: None
      Shaft Diameter: 0.05
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /social_nav_diffusion/projected_trajectory
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.025
      Name: Raw Predicted Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /social_nav_diffusion/predicted_trajectory
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Candidate Trajectories (all K samples)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /social_nav_diffusion/candidate_trajectories
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detected People (circle + velocity horizon arrow)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /people_detector/markers
      Value: true
    - Angle Tolerance: 0.30
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.30
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 150
      Name: Past Robot Trajectory (trail)
      # Position Tolerance must exceed the arrow's own length (shaft+head
      # below, ~0.17 m) or consecutive arrows overlap into a solid smear
      # instead of a clean, spaced-out trail.
      Position Tolerance: 0.25
      Shape:
        Alpha: 0.8
        Axes Length: 0.2
        Axes Radius: 0.02
        Color: 40; 200; 255
        Head Length: 0.07
        Head Radius: 0.035
        Shaft Length: 0.10
        Shaft Radius: 0.02
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        # Matches topics_jackal1_live.yaml. If used against topics.yaml /
        # topics_sim.yaml instead, change this to
        # /cpr_j100_0001/platform/odom/filtered.
        Value: /jackal1/platform/odom/filtered
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
Window Geometry:
  Height: 800
  Width: 1200
