#!/bin/bash

# Check if file is sourced
if [[ $_ == $0 ]]; then
  echo "You need to source this script to have the environment variables set"
  exit 1
fi

# Find own IP on the Wired Husky network
WIRED_NETWORK=192.168.131.
HOST_IP=""

for ip in $(hostname --all-ip-addresses); do
  if [[ $ip == ${WIRED_NETWORK}* ]]; then
    HOST_IP=$ip
  fi
done

# If it couldn't find your static IP, default to the one setup 
if [[ -z "$HOST_IP" ]]; then
    echo "Warning: Could not auto-detect 192.168.131.X IP. Defaulting to 192.168.131.101"
    HOST_IP="192.168.131.101"
fi

ROBOT_IP="192.168.131.1"

# Verify robot is alive over ethernet
set +e
ping -W 1 -q -c 1 $ROBOT_IP > /dev/null
if [ "$?" != "0" ]; then
    echo "Jackal not reachable at $ROBOT_IP. Check your physical cable and static IP setup."
    return
fi

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Dynamically generate the XML configuration from their template
cat fastdds_robot_template.xml | sed "s/ROBOT_IP/${ROBOT_IP}/" | sed "s/HOST_IP/${HOST_IP}/" > fastdds_robot_wired.xml

export FASTRTPS_DEFAULT_PROFILES_FILE=$PWD/fastdds_robot_wired.xml

# Change prompt color so you know you are targeting the wired robot
export PS1='\[\033[01;33m\]WIRED-ROBOT \[\033[01;32m\]\u\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Clear out old background matching nodes
ros2 daemon stop

echo "Successfully connected to Husky locally via Ethernet!"
echo "Your Laptop IP: $HOST_IP"
echo "Husky IP: $ROBOT_IP"