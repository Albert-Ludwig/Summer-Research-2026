
# TODO: catch if this file is not sources
if [[ $_ == $0 ]]; then
  echo "You need to source this script to have the environment variables set"
fi

# find own IP on robohub network
ROBOHUB_NETWORK=129.97.71.
for ip in $(hostname --all-ip-addresses); do
  if [[ $ip == ${ROBOHUB_NETWORK}* ]]; then
	HOST_IP=$ip
  fi
done

if [[ -z "$1" ]]; then
	echo "Need robot IP as argument"
	return
fi

set +e
ping -W 1 -q -c 1 $1 > /dev/null
if [ "$?" != "0" ]; then
	echo "Robot not reachable, check network connection."
fi

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROBOT_IP=$1
cat $HOME/.fastdds_robot_template.xml | sed "s/ROBOT_IP/${ROBOT_IP}/" | sed "s/HOST_IP/${HOST_IP}/" > $HOME/.fastdds_robot.xml

export FASTRTPS_DEFAULT_PROFILES_FILE=$HOME/.fastdds_robot.xml
export PS1='\[\033[01;31m\]ROBOT \[\033[01;32m\]\u@docker\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
echo "If switching setups please stop the background daemon with \"ros2 daemon stop\""
