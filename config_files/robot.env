ROBOTNAME=jackal
# Setting the IP here is necessary because jackals sets ROS_HOSTNAME to "jackalX"
# in case the NS resolution on the client fails, this fixes it
DOCKER_ROBOT_FLAGS="--add-host jackal1:129.97.71.36 --add-host jackal2:129.97.71.37"
if [ -e /dev/input/spacemouse ]; then
	DOCKER_ROBOT_FLAGS="$DOCKER_ROBOT_FLAGS --device /dev/input/spacemouse"
	readlink -f /dev/input/spacemouse > /dev/null
	if [ 0 == "$?" ]; then
		DOCKER_ROBOT_FLAGS="$DOCKER_ROBOT_FLAGS --device $(readlink -f /dev/input/spacemouse)"
	fi
fi
